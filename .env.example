DATABASE_URL=postgresql://career_groove:career_groove@localhost:5432/career_groove
AUTH_SECRET=replace-with-a-long-random-value
PROVIDER_ENCRYPTION_KEY=
# Do not set AUTH_URL when this instance is reachable through both Nginx and
# direct LAN HTTP. Auth.js derives the correct origin from each request.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_APPLE_IOS_CLIENT_ID=com.careergroove.careergroove
APPLE_TEAM_ID=
AUTH_EXPERIMENTAL_ENABLE_PASSKEYS=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Local npm/dev fallback. Docker Compose overrides this with CAREER_GROOVE_OLLAMA_BASE_URL.
OLLAMA_BASE_URL=http://localhost:11434/api
# CareerGroove uses a host Ollama daemon from containers via host.docker.internal.
# Configure the host daemon to listen on 0.0.0.0:11434.
# Existing container-side Ollama configs using http://ollama:11434 remain compatible through a host-gateway alias.
CAREER_GROOVE_OLLAMA_BASE_URL=http://host.docker.internal:11434
# UID/GID used by the backup scheduler container when writing files to ./backups.
CAREER_GROOVE_BACKUP_UID=1000
CAREER_GROOVE_BACKUP_GID=1000
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PROJECT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set this to your actual domain (e.g. https://careergroove.website) for Stripe redirects.
NEXT_PUBLIC_APP_URL=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_PRICE_LIFETIME=
# Stripe price IDs can also be set in the admin panel at /admin/stripe
# which stores them in the settings database table. Env vars take priority.
# Apple Push Notification service (available after joining the Apple Developer Program).
APNS_KEY_ID=
APNS_TEAM_ID=
# Paste the .p8 content with literal \n separators.
APNS_PRIVATE_KEY=
MOBILE_NOTIFICATION_WORKER_SECRET=
MOBILE_NOTIFICATION_INTERVAL_MS=300000
# JSON array of base64-encoded DER Apple root certificates.
APP_STORE_ROOT_CA_BASE64=
# Numeric App Store app ID. Required for production transaction verification.
APP_STORE_APP_APPLE_ID=
# Google Custom Search API (used by follow-up email discovery to find company career email addresses).
# Create a Custom Search Engine at https://programmablesearchengine.google.com and enable it for the web.
# Get an API key at https://console.cloud.google.com under "Custom Search API".
SEARCH_ENGINE_API_KEY=
SEARCH_ENGINE_CX=
